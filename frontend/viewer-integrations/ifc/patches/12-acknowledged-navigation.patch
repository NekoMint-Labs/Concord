+describe('Concord acknowledged navigation SDK boundary', () => {
+  beforeEach(() => { mount() })
+  it('rejects readiness and result messages from another origin', async () => {
+    const v = new IfcViewer('#mount', {baseUrl:BASE})
+    window.dispatchEvent(new MessageEvent('message', {source:v.iframe.contentWindow,origin:'https://untrusted.test',data:{source:'ifc-validator',type:'ready'}}))
+    expect(v.isReady).toBe(false)
+    emitFromIframe(v,{type:'ready'})
+    const post=spyPost(v)
+    let settled=false
+    const pending=v.navigateElements([1,2],'model').then(()=>{settled=true})
+    await tick()
+    const request=postsOfType(post,'ifcviewer:navigate-elements')[0]
+    expect(request).toMatchObject({ids:[1,2],modelId:'model'})
+    window.dispatchEvent(new MessageEvent('message', {source:v.iframe.contentWindow,origin:'https://untrusted.test',data:{source:'ifc-validator',type:'result',requestId:request.requestId,ok:true,data:null}}))
+    await tick(); expect(settled).toBe(false)
+    emitFromIframe(v,{type:'result',requestId:request.requestId,ok:true,data:null})
+    await pending; expect(settled).toBe(true); v.dispose()
+  })
+  it('propagates native fitting failures and awaits selection cleanup', async () => {
+    const v=new IfcViewer('#mount',{baseUrl:BASE}),post=spyPost(v)
+    emitFromIframe(v,{type:'ready'})
+    const pending=v.navigateElements([1,2],'model')
+    const rejected=expect(pending).rejects.toThrow('fit failed')
+    await tick()
+    emitFromIframe(v,{type:'result',requestId:lastRequestId(post),ok:false,error:'fit failed'})
+    await rejected
+    const cleared=v.clearTargetSelection();await tick()
+    expect(postsOfType(post,'ifcviewer:clear-target-selection')).toHaveLength(1)
+    emitFromIframe(v,{type:'result',requestId:lastRequestId(post),ok:true,data:null})
+    await cleared;v.dispose()
+  })
+})
