{
  "name": "construction-coordination-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "generate": "openapi-typescript openapi.json -o src/api/schema.ts",
    "viewer-assets": "node scripts/viewer-assets.mjs",
    "postinstall": "node scripts/viewer-assets.mjs",
    "format": "prettier --write src *.ts *.json",
    "lint": "prettier --check src *.ts *.json",
    "test:transport": "node --experimental-strip-types --test tests/*.test.mjs",
    "e2e:ifc": "playwright test --config playwright.ifc.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.9.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.2.0",
    "react-resizable-panels": "^4.12.4",
    "sonner": "^2.0.8",
    "@tauri-apps/api": "^2.9.0",
    "@thatopen/components": "^3.1.0",
    "@thatopen/fragments": "^3.1.0",
    "three": "^0.184.0",
    "web-ifc": "^0.0.77",
    "maplibre-gl": "^5.12.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "vitest": "^3.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.0",
    "@types/geojson": "^7946.0.16",
    "prettier": "^3.6.0",
    "@tauri-apps/cli": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tauri-apps/cli"
    ]
  }
}
