# Local demo only. Do not expose this profile publicly.
CCA_PROFILE=local
CCA_DATA_DIR=.data
CCA_RUNTIME=dbos
# Stable DBOS-only durable-runtime identity; lowercase letters, numbers, - and _, 3-30 chars.
# CCA_DBOS_APP_NAME=cca
# Deterministic, credential-free default. Keep this for the local demo.
CCA_REASONING=offline
# To use a hosted model instead:
# CCA_REASONING=pydantic-ai
# CCA_MODEL_PROVIDER=openai  # native choices: openai, anthropic, google
# CCA_REASONING_MODEL=gpt-4o-mini
# CCA_MODEL_API_KEY=replace-with-a-local-secret
# Generic OpenAI-compatible endpoint (e.g. a private gateway, Ollama, or vLLM):
# CCA_MODEL_PROVIDER=openai-compatible
# CCA_REASONING_MODEL=provider-model-id
# CCA_MODEL_API_KEY=endpoint-key
# CCA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
CCA_API_TOKEN=local-demo-admin
CCA_VIEWER_TOKEN=local-demo-viewer
CCA_COORDINATOR_TOKEN=local-demo-coordinator
CCA_APPROVER_TOKEN=local-demo-approver
CCA_SAFETY_TOKEN=local-demo-safety
# Fixed PDF/CAD comparison pack is optional and disabled in every profile.
# Provision C's pinned pack first; see docs/COMPARISON_DEPLOYMENT.md.
# CCA_PDF_COMPARISON_ENABLED=false
# CCA_CAD_COMPARISON_ENABLED=false
# CCA_COMPARISON_FRONTEND_ROOT=/absolute/operator-owned/Concord/frontend
# CCA_COMPARISON_NODE=/absolute/operator-owned/node
# Optional engineering providers remain disabled by default.
# CCA_IFC_CLASH_ENABLED=false
# CCA_IDS_VALIDATION_ENABLED=false
# CCA_VISION_ENABLED=false
# CCA_VISION_MODEL=vision-model-id
# Vision uses the selected CCA_MODEL_PROVIDER/API_KEY. Endpoint/model feature support varies.
# CCA_OTEL_ENABLED=false
# CCA_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
